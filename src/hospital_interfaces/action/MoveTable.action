uint8 COMMAND_UP=0
uint8 COMMAND_DOWN=1

# Goal
uint8 command
---
# Result
bool success
string message
# Resting position after the movement. One of the CtTableState lift constants
# (BOTTOM/TOP), or PAUSED when the movement was frozen between the two
# anchors (cancel).
uint8 final_position
---
# Feedback (streamed continuously during movement)
hospital_interfaces/CtTableState telemetry

